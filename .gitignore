!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
results/reports/*
!results/reports/.gitkeep
logs/*
!logs/.gitkeep

